<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinkedIn Dark</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* LinkedIn Dark Palette */
        :root {
            --li-bg: #000000; /* Pure black for the deep background */
            --li-card: #1D2226; /* Dark gray for containers/cards */
            --li-nav: #1B1F23; /* Navbar color */
            --li-text: #E1E9EE; /* Primary text */
            --li-text-muted: #9199A1; /* Secondary text */
            --li-accent: #70B5F9; /* LinkedIn Blue (Light) */
            --li-border: #38434F; /* Border color */
        }

        body {
            background-color: var(--li-bg);
            color: var(--li-text);
            font-family: -apple-system, system-ui, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Fira Sans", Ubuntu, Oxygen, "Oxygen Sans", Cantarell, "Droid Sans", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Lucida Grande", Helvetica, Arial, sans-serif;
        }

        /* Navbar Styling */
        .navbar {
            background-color: var(--li-nav) !important;
            border-bottom: 1px solid var(--li-border) !important;
        }

        .navbar-brand, .nav-link {
            color: var(--li-text) !important;
        }

            .nav-link:hover {
                color: var(--li-accent) !important;
            }

        /* Container Styling */
        .container-main {
            background-color: var(--li-card);
            border: 1px solid var(--li-border);
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        /* Buttons & Inputs */
        .btn-primary {
            background-color: var(--li-accent);
            border: none;
            color: #000;
            font-weight: 600;
        }

        .form-control {
            background-color: #12171B;
            border: 1px solid var(--li-border);
            color: white;
        }

            .form-control:focus {
                background-color: #12171B;
                color: white;
                border-color: var(--li-accent);
                box-shadow: none;
            }

        footer {
            background-color: var(--li-nav);
            border-top: 1px solid var(--li-border) !important;
            color: var(--li-text-muted) !important;
        }

        /* Table Styling for Employee List */
        .table {
            color: var(--li-text);
        }

            .table thead th {
                border-bottom: 2px solid var(--li-border);
                color: var(--li-text-muted);
            }

            .table td {
                border-bottom: 1px solid var(--li-border);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Employees" asp-action="Index">
                    <span style="background-color: #0A66C2; color: white; padding: 0 5px; border-radius: 3px; font-weight: bold;">in</span> <span class="d-none d-md-inline">Corp Directory</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employees" asp-action="Index">
                                    <i class="bi bi-house-door-fill me-1"></i> Home
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <div style="width: 30px; height: 30px; background-color: #70B5F9; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 8px; color: #1B1F23; font-weight: bold; font-size: 0.7rem;">
                                        AD
                                    </div>
                                    <span class="d-none d-lg-inline">Me</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" style="background-color: #1B1F23; border: 1px solid var(--li-border);">
                                    <li><h6 class="dropdown-header text-white">@Context.Session.GetString("UserEmail")</h6></li>
                                    <li><hr class="dropdown-divider" style="background-color: var(--li-border);"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Account" asp-action="Logout">Sign Out</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-outline-primary" asp-controller="Account" asp-action="Login" style="border-radius: 20px; color: var(--li-accent); border-color: var(--li-accent);">Sign In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3 container-main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container">
            &copy; 2026 - EmployeePortal - <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: var(--li-accent);">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>